module sunholo/motoko_ext_ailang_policy/lane

-- The pure half of the ailang_only lane: tool names and schemas, the allowlist
-- decision, request building and the lane prompt. Everything that touches a
-- process or a file is in register.ail.
--
-- The tool names, argument shapes and prompt mirror the pi lane
-- (ailang repo: .pi/extensions/ailang-exec.ts, ailang-lsp-lite.ts,
-- examples-search.ts) so a pi-vs-motoko comparison compares harnesses, not
-- tool vocabularies. The boundary is not here: every file, CLI and run request
-- goes to `ailang policy-tool` / `ailang run --policy`, which decide.
import std/json (Json, encode, jo, kv, js, get, asString, asArray, ja)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import std/list (any)
import std/string (startsWith, endsWith, split, join, length as str_length, substring, contains)
import pkg/sunholo/motoko_ext_abi/types (ToolSchema)

export pure func lane_tools() -> [string] {
  ["ailang_read", "ailang_write", "ailang_edit", "ailang_check", "ailang_run", "ailang_cli", "builtins_search", "examples_search"]
}

export pure func is_lane_tool(name: string) -> bool {
  any(\t. t == name, lane_tools())
}

-- Allowlist, not denylist: a tool this lane does not provide is refused,
-- whichever extension or native catalogue it came from.
export pure func refusal_for(name: string) -> Option[string] {
  if is_lane_tool(name) then None else Some("ailang_only lane: '${name}' is disabled — there is no shell and no native file access. Use ailang_read / ailang_write / ailang_edit / ailang_check / ailang_run / ailang_cli / builtins_search / examples_search.")
}

pure func str_prop(name: string, desc: string) -> string {
  "\"${name}\": {\"type\": \"string\", \"description\": \"${desc}\"}"
}

pure func obj(props: [string], required: [string]) -> string {
  let req = join(", ", map_quote(required))
  "{\"type\": \"object\", \"properties\": {${join(", ", props)}}, \"required\": [${req}]}"
}

pure func map_quote(xs: [string]) -> [string] {
  match xs {
    [] => [],
    x :: rest => "\"${x}\"" :: map_quote(rest)
  }
}

export pure func lane_schemas(cli_ops: string) -> [ToolSchema] {
  [{ name: "ailang_read", description: "Read a file inside the policy's FS sandbox. Paths resolve from the sandbox root; anything outside it, including symlinks that lead outside, is refused. Returns {ok, content} or {ok:false, refused}.", parameters: obj([str_prop("path", "File path, relative to the sandbox root (or absolute inside it)")], ["path"]) }, { name: "ailang_write", description: "Create or overwrite a file inside the policy's FS sandbox. Refused outside it. Returns {ok} or {ok:false, refused}.", parameters: obj([str_prop("path", "File path, relative to the sandbox root"), str_prop("content", "The complete new file content")], ["path", "content"]) }, { name: "ailang_edit", description: "Replace old_text with new_text in a file inside the sandbox; old_text must occur exactly once (include enough context). Returns {ok} or {ok:false, refused}.", parameters: obj([str_prop("path", "File path, relative to the sandbox root"), str_prop("old_text", "Exact text to replace (must occur exactly once)"), str_prop("new_text", "Replacement text")], ["path", "old_text", "new_text"]) }, { name: "ailang_check", description: "Type-check an AILANG file inside the sandbox (`ailang check`). Returns {ok, exit_code, stdout, stderr} or {ok:false, refused}.", parameters: obj([str_prop("path", "The .ail file, relative to the sandbox root")], ["path"]) }, { name: "ailang_run", description: "Execute an AILANG program under the operator's policy: `ailang run --policy <policy>` in the file's directory. The program's declared effect row must be a subset of the policy's allowed_caps; FS stays inside the sandbox; the run is bounded by the policy's timeout. Returns {admitted, exit_code, stdout, stderr}. A denial names missing_from_policy: narrow the program's effects. This is the ONLY way to run code; there is no shell.", parameters: obj([str_prop("path", "Path to the .ail file, relative to the sandbox root"), str_prop("args_json", "Optional JSON arguments for the entrypoint (passed as --args-json)")], ["path"]) }, { name: "ailang_cli", description: "Run an allowlisted ailang operation as a typed request. ops under this policy: ${cli_ops}. Field by op — check/ai_check/fmt/tree/policy_check: {path}; iface/pkg_docs: {module}; docs_search/examples_search: {query}; examples_show/builtins_show: {module: <name>}; test: {path?, package?}. NOT run: execution only goes through ailang_run. Returns {ok, argv, exit_code, stdout, stderr} or {ok:false, refused}.", parameters: obj([str_prop("op", "The operation, e.g. check, iface, docs_search, test"), str_prop("path", "In-sandbox file path (check, ai_check, fmt, tree, policy_check, test)"), str_prop("module", "Module path or name (iface: std/fs; examples_show/builtins_show: a name)"), str_prop("query", "Search text (docs_search, examples_search)"), str_prop("package", "Package directory for test (in-sandbox)")], ["op"]) }, { name: "builtins_search", description: "Search the AILANG builtin/std function inventory by name or text (listDir, readFile, split, ...) instead of guessing a function name. Returns the matching lines.", parameters: obj([str_prop("query", "Text to match against builtin names and signatures")], ["query"]) }, { name: "examples_search", description: "Find working AILANG examples whose text contains the query, before writing a construct you are unsure of.", parameters: obj([str_prop("query", "Text to search the examples for")], ["query"]) }]
}

pure func arg(args: Json, key: string) -> string {
  match get(args, key) {
    None => "",
    Some(j) => match asString(j) {
      None => "",
      Some(s) => s
    }
  }
}

pure func field(key: string, v: string) -> [{ key: string, value: Json }] {
  if v == "" then [] else [kv(key, js(v))]
}

-- The policy-tool request for a lane call. ailang_run and builtins_search are
-- not plain requests (run goes to `ailang run --policy`; builtins_search lists
-- and filters), so they return None here.
export pure func policy_request(tool: string, args: Json) -> Option[string] {
  if tool == "ailang_read" then Some(encode(jo([kv("op", js("read")), kv("path", js(arg(args, "path")))]))) else if tool == "ailang_write" then Some(encode(jo([kv("op", js("write")), kv("path", js(arg(args, "path"))), kv("content", js(arg(args, "content")))]))) else if tool == "ailang_edit" then Some(encode(jo([kv("op", js("edit")), kv("path", js(arg(args, "path"))), kv("old_text", js(arg(args, "old_text"))), kv("new_text", js(arg(args, "new_text")))]))) else if tool == "ailang_check" then Some(encode(jo([kv("op", js("check")), kv("path", js(arg(args, "path")))]))) else if tool == "examples_search" then Some(encode(jo([kv("op", js("examples_search")), kv("query", js(arg(args, "query")))]))) else if tool == "ailang_cli" then Some(encode(jo([kv("op", js(arg(args, "op")))] ++ field("path", arg(args, "path")) ++ field("module", arg(args, "module")) ++ field("query", arg(args, "query")) ++ field("package", arg(args, "package"))))) else None
}

-- A lane path is relative to the sandbox root (or absolute inside it). The
-- authority on "inside" is `ailang run --policy`; this only builds the path.
export pure func resolve_in(root: string, path: string) -> string {
  if startsWith(path, "/") then path else if endsWith(root, "/") then "${root}${path}" else "${root}/${path}"
}

export pure func dir_of(path: string) -> string {
  let parts = split(path, "/")
  let n = list_len(parts)
  if n <= 1 then "." else substring(path, 0, str_length(path) - str_length(last(parts)) - 1)
}

export pure func base_of(path: string) -> string {
  last(split(path, "/"))
}

pure func last(xs: [string]) -> string {
  match xs {
    [] => "",
    [x] => x,
    _ :: rest => last(rest)
  }
}

pure func list_len(xs: [string]) -> int {
  match xs {
    [] => 0,
    _ :: rest => 1 + list_len(rest)
  }
}

export pure func lane_prompt(root: string, caps: string, cli_ops: string) -> string {
  let has = \c. any(\x. x == c, split(caps, ", "));
  let net = if has("Net") || has("Stream") then "Net is limited to the policy's allowed hosts; redirects to other hosts are refused." else "There is no network access. Do not attempt HTTP.";
  let proc = if has("Process") then "Process is limited to the policy's allowed commands." else "There is no process/subprocess access.";
  join("\n", ["## Execution lane: ailang_only", "You have NO shell. Your tools are ailang_read, ailang_edit, ailang_write, ailang_check, ailang_run, builtins_search, examples_search and ailang_cli — nothing else. The native tools (ReadFile, WriteFile, EditFile, BashExec, RunTests, Search) are disabled and every call to them is refused. Use builtins_search({query}) to discover std functions (listDir, readFile, split, …) instead of guessing. Use examples_search({query}) to find a working example before writing a construct you are unsure of. Use ailang_cli({op: \"iface\", module: \"std/fs\"}) for exact signatures of a module's exports before calling them. ailang_read on a directory lists it.", "Package ceilings: a directory with an ailang.toml is a PACKAGE, and its `[effects] max` ceiling applies to EVERY module inside it — a probe program that reads files or runs git will be rejected there (`effect ceiling violation in package …`) no matter what the policy allows. Write scratch/probe programs in `.ailang-scratch/` at the sandbox root — never inside a package directory, and never anywhere else: that one directory is excluded from the commit, and you have no delete tool, so a probe left elsewhere ships in the PR. Only the package's own code goes inside the package. NEVER edit a package's `[effects] max` to make a probe or your own program pass — the ceiling is the package's public contract, and widening it is the change under review, not a workaround.", "Probes are for finding things out, not the deliverable: once you know where the change goes, make it in the real file with ailang_edit, then ailang_check and test it.", "The ONLY way to execute anything is ailang_run on an AILANG (.ail) file you have written. Do not ask for bash, do not describe commands you would run, do not stop after reading: write the program, ailang_check it, then ailang_run it.", "Module naming: a file named report.ail must start with `module report` (the bare file name — no directory prefix, no hyphens); ailang_run runs a file from its own directory.", "Paths: every path you give a tool, and every relative path in a program (readFile, listDir), resolves against the FS SANDBOX ROOT ${root}. Paths outside it — including symlinks that lead outside — are refused.", "Every effect a program uses must be declared in its entry function's effect row (`! {IO, FS}`); the typechecker enforces this through imports, and the gate admits the program only if the declared row is a subset of the policy: allowed effects = {${caps}}.", net, proc, "ailang_cli ops available under this policy: ${cli_ops} — never run (use ailang_run); test evaluates pure tests only.", "A denial names missing_from_policy: narrow the program's effects instead of retrying the same thing. Programs are ordinary AILANG modules with `export func main() -> () ! {…}`; use std/fs, std/io, std/string for what you would have done with shell tools."])
}

-- The canonical AILANG teaching prompt as a system-prompt section (pi's
-- ailang-exec.ts teachingPrompt). Empty when the prompt is unavailable.
export pure func teaching_section(teaching: string) -> string {
  if teaching == "" then "" else "## AILANG language reference (canonical teaching prompt)\n\n${teaching}"
}

-- Inline tests

-- The lane prompt carries pi's guidance (scratch dir, package ceilings, effects
-- by policy), and the teaching section is present only when there is teaching.
pure func test_lane_prompt() -> bool
  tests [
    ((), true)
  ] {
  let p = lane_prompt("/sb", "IO, FS", "check, iface");
  let q = lane_prompt("/sb", "IO, FS, Net, Process", "check");
  contains(p, ".ailang-scratch/") && contains(p, "/sb") && contains(p, "There is no network access")
    && contains(p, "There is no process/subprocess access") && contains(p, "make it in the real file")
    && not contains(q, "There is no network access") && not contains(q, "There is no process")
    && teaching_section("") == "" && contains(teaching_section("T"), "AILANG language reference")
}

pure func test_allowlist() -> bool
  tests [
    ((), true)
  ] {
  let lane_ok = match refusal_for("ailang_run") {
    None => true,
    Some(_) => false
  }
  let bash_denied = match refusal_for("BashExec") {
    None => false,
    Some(_) => true
  }
  let write_denied = match refusal_for("WriteFile") {
    None => false,
    Some(_) => true
  }
  let foreign_denied = match refusal_for("Delegate") {
    None => false,
    Some(_) => true
  }
  lane_ok && bash_denied && write_denied && foreign_denied
}

pure func test_requests() -> bool
  tests [
    ((), true)
  ] {
  let read = match policy_request("ailang_read", jo([kv("path", js("a.ail"))])) {
    Some(r) => r == "{\"op\":\"read\",\"path\":\"a.ail\"}",
    None => false
  }
  let run_none = match policy_request("ailang_run", jo([kv("path", js("a.ail"))])) {
    None => true,
    Some(_) => false
  }
  let bash_none = match policy_request("BashExec", jo([])) {
    None => true,
    Some(_) => false
  }
  let cli = match policy_request("ailang_cli", jo([kv("op", js("iface")), kv("module", js("std/fs"))])) {
    Some(r) => r == "{\"op\":\"iface\",\"module\":\"std/fs\"}",
    None => false
  }
  read && run_none && bash_none && cli
}

pure func test_paths() -> bool
  tests [
    ((), true)
  ] {
  resolve_in("/ws", "benchmark/solution.ail") == "/ws/benchmark/solution.ail" && resolve_in("/ws/", "a.ail") == "/ws/a.ail" && resolve_in("/ws", "/ws/a.ail") == "/ws/a.ail" && dir_of("/ws/benchmark/solution.ail") == "/ws/benchmark" && base_of("/ws/benchmark/solution.ail") == "solution.ail"
}

-- ailang_edit requests, one per edit. Accepts the lane shape {path, old_text,
-- new_text} and motoko's native EditFile shape {path, edits: [{old, new}]}:
-- models reach for the native shape (the 2026-10-01 lane A/B saw one run spend
-- 95 of its 120 steps on "old_text is required" refusals). Each edit becomes
-- one policy-tool edit request, applied in order by the caller. Neither shape
-- is an error that names both, so the model can correct itself.
export pure func edit_requests(args: Json) -> Result[[string], string] {
  let path = arg(args, "path");
  if arg(args, "old_text") != "" then Ok([edit_request(path, arg(args, "old_text"), arg(args, "new_text"))])
  else match get(args, "edits") {
    None => Err("ailang_edit needs {path, old_text, new_text} or {path, edits: [{old, new}, ...]}; got neither"),
    Some(j) => match asArray(j) {
      None => Err("ailang_edit: edits must be a list of {old, new}"),
      Some(items) => edits_of(path, items)
    }
  }
}

pure func edit_request(path: string, old_text: string, new_text: string) -> string {
  encode(jo([kv("op", js("edit")), kv("path", js(path)), kv("old_text", js(old_text)), kv("new_text", js(new_text))]))
}

pure func edits_of(path: string, items: [Json]) -> Result[[string], string] {
  match items {
    [] => Ok([]),
    e :: rest => {
      let old = if arg(e, "old") != "" then arg(e, "old") else arg(e, "old_text");
      let new = if arg(e, "old") != "" then arg(e, "new") else arg(e, "new_text");
      if old == "" then Err("ailang_edit: every edit needs old (and new)")
      else match edits_of(path, rest) {
        Err(m) => Err(m),
        Ok(more) => Ok(edit_request(path, old, new) :: more)
      }
    }
  }
}

pure func test_edit_requests() -> bool
  tests [((), true)]
  {
    let lane = match edit_requests(jo([kv("path", js("a.ail")), kv("old_text", js("x")), kv("new_text", js("y"))])) { Ok([r]) => r == "{\"op\":\"edit\",\"path\":\"a.ail\",\"old_text\":\"x\",\"new_text\":\"y\"}", _ => false };
    let native = match edit_requests(jo([kv("path", js("a.ail")), kv("edits", ja([jo([kv("old", js("a")), kv("new", js("b"))]), jo([kv("old", js("c")), kv("new", js("d"))])]))])) { Ok([_, _]) => true, _ => false };
    let neither = match edit_requests(jo([kv("path", js("a.ail"))])) { Err(m) => m != "", Ok(_) => false };
    lane && native && neither
  }

